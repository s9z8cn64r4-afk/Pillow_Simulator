--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local NumberFormat = require(Shared.Util.NumberFormat)

return function(it, expect)
	it("kleine Zahlen ohne Suffix, abgerundet", function()
		expect(NumberFormat.short(0)).toBe("0")
		expect(NumberFormat.short(12.9)).toBe("12")
		expect(NumberFormat.short(999.99)).toBe("999")
	end)
	it("Suffixe und Abschneiden statt Runden", function()
		expect(NumberFormat.short(1000)).toBe("1K")
		expect(NumberFormat.short(1234)).toBe("1.23K")
		expect(NumberFormat.short(1999)).toBe("1.99K")
		expect(NumberFormat.short(45600)).toBe("45.6K")
		expect(NumberFormat.short(999999)).toBe("999K")
		expect(NumberFormat.short(1500000)).toBe("1.5M")
		expect(NumberFormat.short(80000000)).toBe("80M")
		expect(NumberFormat.short(17280000000)).toBe("17.2B")
		expect(NumberFormat.short(5e12)).toBe("5T")
		expect(NumberFormat.short(1e15)).toBe("1Qa")
	end)
	it("NaN und negative Werte", function()
		expect(NumberFormat.short(0 / 0)).toBe("0")
		expect(NumberFormat.short(-1500)).toBe("-1.5K")
	end)
	it("full mit Tausendertrennern", function()
		expect(NumberFormat.full(1234567)).toBe("1,234,567")
		expect(NumberFormat.full(999)).toBe("999")
	end)
end
