        "sexual_content",
        "slurs"
      ]
    },
    {
      "name": "Spam",
      "trigger": "spam"
    },
    {
      "name": "Mention spam",
      "trigger": "mention_spam",
      "limit": 5
    },
    {
      "name": "Foreign invites & scam links",
      "trigger": "keyword",
      "regex": [
        "discord(\\.gg|app\\.com/invite|\\.com/invite)/\\S+",
        "free\\s*robux",
        "robux\\s*(generator|gratis|free)"
      ]
    }
